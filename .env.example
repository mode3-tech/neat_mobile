# Base API URL — injected at build time via Expo public env vars
EXPO_PUBLIC_API_URL=https://neat-mobile-backend-nhsk.onrender.com/api/v1

# EXPO_PUBLIC_APP_VARIANT is intentionally NOT listed here — set it in eas.json per
# build profile, never in a local .env. See the note in .env for why a local value
# can brick a preview build via `eas update`. Documented in README.md.
